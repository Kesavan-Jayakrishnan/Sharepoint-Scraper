

@page "/"

<h1>Todo List</h1>

<div class="mb-3">
	<input @bind="newTodo" @bind:event="oninput" placeholder="Add a new todo..." class="form-control" />
	<button class="btn btn-primary mt-2" @onclick="AddTodo" disabled="@(string.IsNullOrWhiteSpace(newTodo))">Add</button>
</div>

<ul class="list-group">
	@foreach (var todo in todos)
	{
		<li class="list-group-item d-flex justify-content-between align-items-center">
			@todo
			<button class="btn btn-danger btn-sm" @onclick="() => RemoveTodo(todo)">Remove</button>
		</li>
	}
</ul>

@code {
	private List<string> todos = new();
	private string newTodo = string.Empty;

	private void AddTodo()
	{
		if (!string.IsNullOrWhiteSpace(newTodo))
		{
			todos.Add(newTodo);
			newTodo = string.Empty;
		}
	}

	private void RemoveTodo(string todo)
	{
		todos.Remove(todo);
	}
}
